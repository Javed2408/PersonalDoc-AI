# Copy to backend/.env and adjust as needed.
APP_NAME=PersonalDoc AI
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local runtime data (uploaded PDFs and metadata). Relative paths resolve against backend/.
DATA_DIR=data
# Maximum size of a single uploaded file, in megabytes.
MAX_UPLOAD_SIZE_MB=25

# Text chunking (characters). CHUNK_OVERLAP must be smaller than CHUNK_SIZE.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Local embedding model (Hugging Face / sentence-transformers). Downloaded (~90 MB) on
# first use into the Hugging Face cache (~/.cache/huggingface), not into this repo.
# Changing it requires re-indexing: also set a new CHROMA_COLLECTION.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# cpu, cuda, mps... Leave empty to auto-detect. cpu is the most reproducible.
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ChromaDB vector store. CHROMA_DIR defaults to <DATA_DIR>/chroma.
# CHROMA_DIR=data/chroma
CHROMA_COLLECTION=personaldoc_chunks

# Retrieval: default number of chunks per query, and the most a request may ask for.
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_K=20
# Optional cosine-distance cut-off (0..2, lower = more similar). Empty = off (default).
# Leave off until evaluation (Phase 9) justifies a value; see evaluation/results/.
RETRIEVAL_MAX_DISTANCE=

# Local LLM via Ollama (https://ollama.com). Install Ollama, then: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Conservative defaults for factual document QA.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
# Model context window (tokens); must fit instructions + context + question + answer.
LLM_CONTEXT_WINDOW=4096
LLM_TIMEOUT_SECONDS=120

# RAG: retrieved chunks with cosine distance above RAG_MAX_DISTANCE are not used as evidence.
# If none qualify, the answer is "not found" and the LLM is not called. Provisional value.
RAG_MAX_DISTANCE=0.7
# Maximum characters of document text placed in the prompt (whole chunks, best first).
RAG_MAX_CONTEXT_CHARS=6000

# Optional: stop sentence-transformers checking the Hugging Face Hub once the model is cached.
# HF_HUB_OFFLINE=1
