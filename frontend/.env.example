# Copy to frontend/.env.local and adjust as needed.

# Backend URL used by the Vite dev server proxy for /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: call the backend directly instead of through the dev proxy
# (e.g. http://127.0.0.1:8000). Leave empty to use relative /api paths.
VITE_API_BASE_URL=
